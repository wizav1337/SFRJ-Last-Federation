    {
      "id": "renounce_leading_role",
      "date": "1990-01-23",
      "act": 1,
      "desk": "SKJ",
      "priority": "mandatory",
      "title": "Vodeća uloga",
      "location": "Savezni stranački uredi / hodnik Skupštine",
      "briefing": "I nakon odlaska netko mora reći tvrdi li ono što je ostalo od SKJ-a još ustavno ukrašenu vodeću ulogu u društvu. Odricanje otvara višestranački zakon. Zadržavanje znači da ćete prve izbore voditi kao monopolist u godini u kojoj monopol umire u svakom glavnom gradu osim vašeg. Ako se odreknete, kasniji spisi ne smiju pretpostavljati pravni monopol.",
      "constitutional_note": "Vodeća uloga je jezik političkog sustava, ne sekretarijat. Ukloniti je treba stranačka odluka plus savezni i republikanski statuti ako želite da bude stvarna.",
      "documents": [
        "1974_art_leading_role",
        "1974_federation"
      ],
      "choices": [
        {
          "id": "renounce",
          "label": "Odrekni se monopola. Predloži savezni zakon o političkom pluralizmu.",
          "legal": "party",
          "effects": {
            "federal.skj_leading_role": 0,
            "federal.legitimacy": 6,
            "federal.reform_momentum": 8,
            "SI.federal_trust": 8,
            "HR.opposition_org": 8,
            "RS.elite_cohesion": -6,
            "flags_add": [
              "skj_renounced_monopoly"
            ]
          }
        },
        {
          "id": "delay",
          "label": "Odgodi. Neka svaka republika prvo napiše vlastiti zakon.",
          "legal": "party",
          "effects": {
