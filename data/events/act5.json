    {
      "id": "governments_vs_siv",
      "date": "1991-01-07",
      "act": 5,
      "desk": "SIV",
      "priority": "mandatory",
      "title": "Kabineti koji više ne prepisuju SIV",
      "location": "Zgrada SIV-a, Novi Beograd / republikanski glavni gradovi",
      "briefing": "Ante Marković još je predsjednik SIV-a. Nije postao „predsjednik Jugoslavije“. Republikanski kabineti izabrani lani — tko god pobijedio: DEMOS ako drži Ljubljanu, HDZ ako drži Sabor, SPS ako drži Beograd, SK CG, SKM, i bosanske stranke — više ne tretiraju savezni spis kao svoj. Ne pišite da DEMOS već vlada ako izbor nije pao tako. SIV ima program i sve tanju knjigu. Možete inzistirati na saveznoj nadležnosti, poslati Markovića na turneju glavnih gradova, ili napisati da je kabinet osam republika već fikcija.",
      "constitutional_note": "SIV izvršava savezni zakon. Ne imenuje republikanske ministre. Republika koja ignorira savezni statut u nepoštovanju je. Republika koja jednostavno zakonodavstvuje pokraj vas rabi preostalu nadležnost iz 1974. dok to ne imenujete drugačije.",
      "documents": [
        "1974_siv",
        "1974_federation"
      ],
      "choices": [
