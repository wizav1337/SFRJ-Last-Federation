                "posture": "bind_justice"
              },
              "justice": {
                "posture": "constitutional"
              }
            }
          }
        },
        {
          "id": "soft_memo",
          "label": "Pošalji meki legitimacijski memo Predsjedništvu.",
          "next": null,
          "effects": {
            "federal.legitimacy": 2,
            "federal.war_risk": -1,
            "flags_add": [
              "dialogue_buzadzic_revisit",
