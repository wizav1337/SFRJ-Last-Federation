  "nodes": {
    "start": {
      "text": "Drnovšek još drži čekić. „Slovenija nije otišla iz institucija. Ali ako Kongres i izbori prođu kao da Savez još zapovijeda Saborima, Ljubljana će pisati vlastiti kalendar.“",
      "choices": [
        {
          "id": "invite",
          "label": "Pozovi Sloveniju da ostane za stolom — i poslije Kongresa.",
          "next": "invite",
          "effects": {
            "desk_add": { "presidency": { "loyalty": 4 } },
            "SI.federal_trust": 6,
            "SI.secession_readiness": -3,
            "flags_add": ["talked_drnovsek", "slovenia_invited_back", "dialogue_drnovsek_invite"]
          }
        },
        {
          "id": "pressure",
          "label": "Prisili postupak: Savez prije republike.",
          "next": "pressure",
          "effects": {
            "desk_add": { "presidency": { "agenda_tension": 6 } },
            "SI.federal_trust": -6,
            "SI.secession_readiness": 5,
            "flags_add": ["talked_drnovsek", "dialogue_drnovsek_pressure"]
          }
        },
        {
          "id": "neutral",
          "label": "Ostavi rotaciju kalendaru. Bez novih uvjeta.",
          "next": "neutral",
          "effects": {
            "flags_add": ["talked_drnovsek"]
          }
        }
      ]
    },
    "invite": {
      "text": "„Dobro. Ali poziv nije jamstvo. Treba vam SIV koji još plaća i Predsjedništvo koje se još može sastati.“",
      "choices": [
        {
          "id": "end_inv",
          "label": "Zapiši poziv.",
          "next": null,
          "effects": {
            "federal.presidency_cohesion": 2
          }
        }
      ]
    },
    "pressure": {
      "text": "Ne diže glas. Samo bilježi da je savezni centar izabrao pritisak umjesto stola.",
      "choices": [
        {
          "id": "end_pr",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.war_risk": 1
          }
        }
      ]
    },
    "neutral": {
      "text": "Kalendar ostaje kalendar. Ništa nije popravljeno — ništa nije spaljeno.",
      "choices": [
        {
