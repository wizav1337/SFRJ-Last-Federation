{
  "id": "drnovsek",
  "speaker": "Janez Drnovšek",
  "title": "Predsjedatelj Predsjedništva (do 15. V 1990.)",
  "desk": "presidency",
  "unlock": {},
  "available_until": "1990-05-15",
  "nodes": {
    "start": {
      "text": "Drnovšek još drži čekić. „Slovenija nije otišla iz institucija. Ali ako Kongres i izbori prođu kao da Savez još zapovijeda Saborima, Ljubljana će pisati vlastiti kalendar.“",
      "choices": [
        {
          "id": "invite",
          "label": "Pozovi Sloveniju da ostane za stolom — i poslije Kongresa.",
          "next": "invite",
          "effects": {
            "desk_add": {
              "presidency": {
                "loyalty": 4
              }
            },
            "SI.federal_trust": 6,
            "SI.secession_readiness": -3,
            "flags_add": [
              "talked_drnovsek",
              "slovenia_invited_back",
              "dialogue_drnovsek_invite"
            ]
          }
        },
        {
          "id": "pressure",
          "label": "Prisili postupak: Savez prije republike.",
          "next": "pressure",
          "effects": {
            "desk_add": {
              "presidency": {
                "agenda_tension": 6
              }
            },
            "SI.federal_trust": -6,
            "SI.secession_readiness": 5,
            "flags_add": [
              "talked_drnovsek",
              "dialogue_drnovsek_pressure"
            ]
          }
        },
        {
          "id": "neutral",
          "label": "Ostavi rotaciju kalendaru. Bez novih uvjeta.",
          "next": "neutral",
          "effects": {
            "flags_add": [
              "talked_drnovsek"
            ]
          }
        }
      ]
    },
    "invite": {
      "text": "„Dobro. Ali poziv nije jamstvo. Treba vam SIV koji još plaća i Predsjedništvo koje se još može sastati.“",
      "choices": [
        {
          "id": "end_inv",
          "label": "Zapiši poziv — i pitaj za izbore.",
          "next": "invite_elect",
          "effects": {
            "federal.presidency_cohesion": 2
          }
        }
      ]
    },
    "pressure": {
      "text": "Ne diže glas. Samo bilježi da je savezni centar izabrao pritisak umjesto stola.",
      "choices": [
        {
          "id": "end_pr",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.war_risk": 1
          }
        }
      ]
    },
    "neutral": {
      "text": "Kalendar ostaje kalendar. Ništa nije popravljeno — ništa nije spaljeno.",
      "choices": [
        {
          "id": "end_n",
          "label": "Zatvori.",
          "next": null,
          "effects": {}
        }
      ]
    },
    "invite_elect": {
      "text": "„Ako Savez pošalje promatrače umjesto tenkova, DEMOS ili ZKS–SDP — tko god pobijedi — još može govoriti o Savezu. Kučan nije zapovjednik JNA. Zapamtite to.“",
      "choices": [
        {
          "id": "observers",
          "label": "Najavi savezne promatrače na slovenskim izborima.",
          "next": null,
          "effects": {
            "flags_add": [
              "federal_observers_si",
              "dialogue_drnovsek_observers"
            ],
            "SI.federal_trust": 3,
            "federal.legitimacy": 2
          }
        },
        {
          "id": "no_obs",
          "label": "Ostavi izbore republici.",
          "next": null,
          "effects": {
            "flags_add": [
              "dialogue_drnovsek_observers"
            ]
          }
        }
      ]
    },
    "after_congress": {
      "text": "Drnovšek vas prima nakon Kongresa. „Slovenija je izašla iz dvorane, ne iz institucija. Ako Savez odgovori inventurom i prijetnjom umjesto stola, kalendar će se pisati u Ljubljani — i prije svibnja.“",
      "choices": [
        {
          "id": "reassure",
          "label": "Ponovi poziv za stol — bez inventure kao kazne.",
          "next": null,
          "effects": {
            "desk_add": {
              "presidency": {
                "loyalty": 3
              }
            },
            "SI.federal_trust": 4,
            "SI.secession_readiness": -2,
            "federal.presidency_cohesion": 2,
            "flags_add": [
              "slovenia_invited_back",
              "dialogue_drnovsek_congress"
            ]
          }
        },
        {
          "id": "procedure",
          "label": "Postupak: Kongres je gotov; izbori su republikanski.",
          "next": null,
          "effects": {
            "federal.legitimacy": 1,
            "SI.federal_trust": 1,
            "flags_add": [
              "dialogue_drnovsek_congress"
            ]
          }
        },
        {
          "id": "warn",
          "label": "Upozori: Savez neće trpjeti jednostrane kalendare.",
          "next": null,
          "effects": {
            "desk_add": {
              "presidency": {
                "agenda_tension": 5
              }
            },
            "SI.secession_readiness": 4,
            "SI.federal_trust": -4,
            "federal.war_risk": 1,
            "flags_add": [
              "dialogue_drnovsek_congress",
              "dialogue_drnovsek_pressure"
            ]
          }
        }
      ]
    },
    "spring_corridor": {
      "text": "Proljeće 1990. Drnovšek još drži čekić. „Imate SIV, imate TO papir, imate izbore pred vratima. Medijacija sada je jeftinija od dekreta u svibnju.“",
      "choices": [
        {
          "id": "mediate_spring",
          "label": "Otvori proljetni koridor medijacije.",
          "next": null,
          "effects": {
            "desk_set": {
              "presidency": {
                "posture": "mediate"
              }
            },
            "desk_add": {
              "presidency": {
                "loyalty": 2
              }
            },
            "federal.presidency_cohesion": 3,
            "federal.war_risk": -2,
            "flags_add": [
              "presidency_mediation_active",
              "dialogue_drnovsek_spring"
            ]
          }
        },
        {
          "id": "quorum_spring",
          "label": "Čuvaj kvorum Predsjedništva do rotacije.",
          "next": null,
          "effects": {
            "federal.presidency_cohesion": 2,
            "federal.legitimacy": 2,
            "flags_add": [
              "presidency_quorum_guard",
              "dialogue_drnovsek_spring"
            ]
          }
        },
        {
          "id": "wait_spring",
          "label": "Pričekaj izbore. Bez novog papira.",
          "next": null,
          "effects": {
            "flags_add": [
              "dialogue_drnovsek_spring"
            ]
          }
        }
      ]
    },
    "eve_rotation": {
      "text": "Uoči 15. svibnja. „Jović preuzima čekić. Ja odlazim s mjesta predsjedatelja — ne iz Predsjedništva kao član dok me zamjene. Ako želite konfederalni jezik kasnije, ne spalite kvorum sada.“",
      "choices": [
        {
          "id": "handoff_soft",
          "label": "Meki prijelaz: zapiši kvorum i poziv Sloveniji.",
          "next": null,
          "effects": {
            "federal.presidency_cohesion": 3,
            "SI.federal_trust": 3,
            "flags_add": [
              "presidency_quorum_guard",
              "slovenia_invited_back",
              "dialogue_drnovsek_eve"
            ]
          }
        },
        {
          "id": "handoff_note",
          "label": "Zapiši samo bilješku — bez novih uvjeta.",
          "next": null,
          "effects": {
            "federal.legitimacy": 1,
            "flags_add": [
              "dialogue_drnovsek_eve"
            ]
          }
        },
        {
          "id": "handoff_hard",
          "label": "Tvrdi prijelaz: Savez prije stola.",
          "next": null,
          "effects": {
            "desk_set": {
              "presidency": {
                "posture": "hardline"
              }
            },
            "federal.presidency_cohesion": -2,
            "SI.secession_readiness": 3,
            "flags_add": [
              "presidency_hardline",
              "dialogue_drnovsek_eve"
            ]
          }
        }
      ]
    }
  },
