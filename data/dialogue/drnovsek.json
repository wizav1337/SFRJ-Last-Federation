{
  "id": "drnovsek",
  "speaker": "Janez Drnovšek",
  "title": "Predsjedatelj Predsjedništva (do 15. V 1990.)",
  "desk": "presidency",
  "unlock": {},
  "available_until": "1990-05-15",
  "nodes": {
    "start": {
      "text": "Drnovšek još drži čekić. „Slovenija nije otišla iz institucija. Ali ako Kongres i izbori prođu kao da Savez još zapovijeda Saborima, Ljubljana će pisati vlastiti kalendar.“",
      "choices": [
        {
          "id": "invite",
          "label": "Pozovi Sloveniju da ostane za stolom — i poslije Kongresa.",
          "next": "invite",
          "effects": {
            "desk_add": {
              "presidency": {
                "loyalty": 4
              }
            },
            "SI.federal_trust": 6,
            "SI.secession_readiness": -3,
            "flags_add": [
              "talked_drnovsek",
              "slovenia_invited_back",
              "dialogue_drnovsek_invite"
            ]
          }
        },
        {
          "id": "pressure",
          "label": "Prisili postupak: Savez prije republike.",
          "next": "pressure",
          "effects": {
            "desk_add": {
              "presidency": {
                "agenda_tension": 6
              }
            },
            "SI.federal_trust": -6,
            "SI.secession_readiness": 5,
            "flags_add": [
              "talked_drnovsek",
              "dialogue_drnovsek_pressure"
            ]
          }
        },
        {
          "id": "neutral",
          "label": "Ostavi rotaciju kalendaru. Bez novih uvjeta.",
          "next": "neutral",
          "effects": {
            "flags_add": [
              "talked_drnovsek"
            ]
          }
        }
      ]
    },
    "invite": {
      "text": "„Dobro. Ali poziv nije jamstvo. Treba vam SIV koji još plaća i Predsjedništvo koje se još može sastati.“",
      "choices": [
        {
          "id": "end_inv",
          "label": "Zapiši poziv — i pitaj za izbore.",
          "next": "invite_elect",
          "effects": {
            "federal.presidency_cohesion": 2
          }
        }
      ]
    },
    "pressure": {
      "text": "Ne diže glas. Samo bilježi da je savezni centar izabrao pritisak umjesto stola.",
      "choices": [
        {
          "id": "end_pr",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.war_risk": 1
          }
        }
      ]
    },
    "neutral": {
      "text": "Kalendar ostaje kalendar. Ništa nije popravljeno — ništa nije spaljeno.",
      "choices": [
        {
          "id": "end_n",
          "label": "Zatvori.",
          "next": null,
          "effects": {}
        }
      ]
    },
    "invite_elect": {
      "text": "„Ako Savez pošalje promatrače umjesto tenkova, DEMOS ili ZKS–SDP — tko god pobijedi — još može govoriti o Savezu. Kučan nije zapovjednik JNA. Zapamtite to.“",
      "choices": [
        {
          "id": "observers",
          "label": "Najavi savezne promatrače na slovenskim izborima.",
          "next": null,
          "effects": {
            "flags_add": [
              "federal_observers_si",
              "dialogue_drnovsek_observers"
            ],
            "SI.federal_trust": 3,
            "federal.legitimacy": 2
          }
        },
        {
          "id": "no_obs",
          "label": "Ostavi izbore republici.",
          "next": null,
          "effects": {
            "flags_add": [
              "dialogue_drnovsek_observers"
            ]
          }
        }
      ]
    }
  }
