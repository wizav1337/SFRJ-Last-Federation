    "start": {
      "text": "Gračanin prima u Saveznom sekretarijatu za unutarnje poslove. „SDB je servis, ne fronta. Civilni uze, promatranje, dosjei ili zategnuti uze — sve papir. Marković ostaje predsjednik SIV-a. Ja držim kanal SSUP–SDB. Što želite od službe?“",
      "choices": [
        {
          "id": "leash",
          "label": "Civilni uze — Predsjedništvo i SIV iznad SDB.",
          "next": "leash_done",
          "effects": {
            "desk_add": {
              "sdb": {
                "loyalty": 4,
                "agenda_tension": -3
              },
              "ssup": {
                "loyalty": 2
              }
            },
            "federal.sdb_control": 4,
            "federal.legitimacy": 2,
            "federal.presidency_cohesion": 2,
            "federal.war_risk": -2,
            "flags_add": [
