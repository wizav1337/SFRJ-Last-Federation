              "dialogue_gracanin_leash",
              "sdb_civilian_leash",
              "sdb_quiet_paper"
            ],
            "flags_remove": [
              "sdb_leash_tight"
            ],
            "desk_set": {
              "sdb": {
                "posture": "civilian_leash"
              }
            }
          }
        },
        {
          "id": "observe",
