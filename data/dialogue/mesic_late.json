            ]
          }
        }
      ]
    },
    "leverage": {
      "text": "Poluga bez riječi „blokada zatvara E3“ još visi. Kohezija pada; put prema zastoju kraći. Jović nije Milošević — ali postupak puca ako netko odbije sjediti.",
      "choices": [
        {
          "id": "end_leverage",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.war_risk": 1,
            "federal.legitimacy": -1
          }
        }
      ]
    },
    "conf": {
      "text": "„Konfederalni stol prije svibnja — da. Izetbegović–Gligorov nije papir koji potpisujem ovdje. Samo isključenje. Marković nosi knjige SIV-a.“",
      "choices": [
        {
          "id": "end_conf",
