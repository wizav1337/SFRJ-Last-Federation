    "duty": {
      "text": "„Dobro. Dužnost nije auto-sjedenje danas. Kad kalendar dođe, sjedit ću ako me ne blokiraju. E3 traži organ koji se može sastati — ne prazan hodnik.“",
      "choices": [
        {
          "id": "end_duty",
          "label": "Zapiši — bez pečata sjedenja sada.",
          "next": null,
          "effects": {
            "federal.war_risk": -1,
            "federal.legitimacy": 1,
            "flags_add": [
