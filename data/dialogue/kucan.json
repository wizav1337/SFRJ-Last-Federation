    "conf": {
      "text": "„Dobro. Ali stol nije priznanje. Tražim da Predsjedništvo ostane organ koji se može sastati — inače je konfederacija prazan papir. E3 to zna.“",
      "choices": [
        {
          "id": "end_conf",
          "label": "Zapiši poziv i kvorum.",
          "next": null,
          "effects": {
            "flags_add": [
