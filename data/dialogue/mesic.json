{
  "id": "mesic",
  "speaker": "Stipe Mesić",
  "title": "Hrvatski član Predsjedništva (nakon HDZ-a)",
  "desk": "presidency",
  "unlock": {
    "flags": [
      "hdz_croatia"
    ]
  },
  "nodes": {
    "start": {
      "text": "Mesić još nije predsjedatelj — ali već zna da će 15. svibnja 1991. biti dužan sjediti. „Blokada nije sjedenje. Sjedenje drži stolac ispunjenim. Blokada isključuje konfederalni završetak. To nije moja poetika — to je vaša matematika.“",
      "choices": [
        {
          "id": "promise_seat",
          "label": "Obećaj potporu sjedenju kad dođe red.",
          "next": "seat",
          "effects": {
            "desk_add": {
              "presidency": {
                "loyalty": 4,
                "agenda_tension": -3
              }
            },
            "HR.federal_trust": 4,
            "flags_add": [
              "talked_mesic",
              "dialogue_mesic_seat",
              "presidency_mediation_active"
            ],
            "desk_set": {
              "presidency": {
                "posture": "mediate"
              }
            }
          }
        },
        {
          "id": "hint_block",
          "label": "Nagovijesti da zastoj može biti poluga.",
          "next": "block",
          "effects": {
            "desk_add": {
              "presidency": {
                "agenda_tension": 9,
                "loyalty": -5
              }
            },
            "federal.presidency_cohesion": -6,
            "HR.secession_readiness": 4,
            "flags_add": [
              "talked_mesic",
              "dialogue_mesic_block"
            ],
            "desk_set": {
              "presidency": {
                "posture": "hardline"
              }
            }
          }
        },
        {
          "id": "confederal",
          "label": "Traži otvoreni konfederalni stol prije rotacije.",
          "next": "conf",
          "effects": {
            "desk_add": {
              "presidency": {
                "loyalty": 3
              }
            },
            "federal.legitimacy": 2,
            "SI.federal_trust": 3,
            "flags_add": [
              "talked_mesic",
              "confederal_talks_open",
              "slovenia_invited_back",
              "dialogue_mesic_confederal"
            ],
            "desk_set": {
              "presidency": {
                "posture": "mediate"
              }
            }
          }
        }
      ]
    },
    "seat": {
      "text": "„Dobro. Kad dođe kalendar, sjedit ću ako me ne blokiraju. Zapamtite razliku — E3 je zahtijeva.“",
      "choices": [
        {
          "id": "end_seat",
          "label": "Zapiši — i pitaj za Sabor i JNA.",
          "next": "seat_late",
          "effects": {
            "flags_add": [
              "presidency_quorum_guard"
            ]
          }
        }
      ]
    },
    "block": {
      "text": "Ne kaže da će blokirati. Kaže da „stolac nije igračka“. Dosje bilježi tvrđi put — bliže zastoju, dalje od E3.",
      "choices": [
        {
          "id": "end_block",
          "label": "Zatvori.",
          "next": null,
          "effects": {
            "federal.war_risk": 2
          }
        }
      ]
    },
    "conf": {
      "text": "„Stol prije svibnja. Ako potpišemo jezik konfederacije, rotacija nije pogreb.“",
      "choices": [
        {
          "id": "end_conf",
          "label": "Otvori dosje razgovora.",
          "next": null,
          "effects": {
            "charter_signatures_min": 1
          }
        }
      ]
    },
    "seat_late": {
      "text": "„Ako JNA digne pripravnost kao odgovor na HDZ, Zagreb će to čuti kao ultimatum. Ako SSUP ide meko nakon balvana, još ima prostora za stol. Ja mogu sjediti — ali ne mogu sam držati federaciju.“",
      "choices": [
        {
          "id": "seat_soft",
          "label": "Obveži meku liniju SSUP i garnizon JNA.",
          "next": null,
          "effects": {
            "desk_set": {
              "ssup": {
                "posture": "soft"
              },
              "jna": {
                "posture": "garrison"
              }
            },
            "flags_add": [
              "ssup_soft_line",
              "jna_garrison_posture",
              "dialogue_mesic_late"
            ],
            "flags_remove": [
              "ssup_hard_line",
              "jna_mobilization_alert"
            ],
            "HR.federal_trust": 3,
            "federal.war_risk": -2
          }
        },
        {
          "id": "seat_only",
          "label": "Samo sjedenje. Bez novih naredbi.",
          "next": null,
          "effects": {
            "flags_add": [
              "dialogue_mesic_late"
            ]
          }
        }
      ]
    },
    "revisit_may": {
      "text": "Mesić zna da je 15. svibnja blizu. „Dušan sam uzeti stolac. Blokada je zastoj — i E3 je gotov. Sjedenje nije kapitulacija; zastoj jest. Ako imate potpise, recite to Predsjedništvu prije rotacije.“",
      "choices": [
        {
          "id": "prep_seat",
          "label": "Pripremi sjedenje i čuvaj kvorum.",
          "next": null,
          "effects": {
            "federal.presidency_cohesion": 3,
            "charter_signatures_add": 1,
            "flags_add": [
              "dialogue_mesic_revisit",
              "dialogue_mesic_seat",
              "presidency_quorum_guard",
              "confederal_talks_open"
            ],
            "flags_remove": [
              "presidency_deadlock"
            ],
            "desk_set": {
              "presidency": {
                "posture": "mediate"
              }
            }
          }
        },
        {
          "id": "hint_block",
          "label": "Drži opciju blokade u rezervi.",
          "next": null,
          "effects": {
            "federal.presidency_cohesion": -3,
            "HR.secession_readiness": 3,
            "flags_add": [
              "dialogue_mesic_revisit",
              "dialogue_mesic_block"
            ]
          }
        }
      ]
    }
  },
