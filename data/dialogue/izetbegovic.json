  "nodes": {
    "start": {
      "text": "Izetbegović govori odmjeno. „Medijacija — da. Stol mirnodopski. Ali nemojte očekivati nacrt Izetbegović–Gligorov: to je lipanj, van ovog odsječka. Ovdje samo most, ne papir o razdruživanju.“",
      "choices": [
        {
          "id": "mediate_only",
          "label": "Samo medijacija: BiH kao most.",
          "next": "mediate",
          "effects": {
            "desk_add": { "presidency": { "loyalty": 3, "agenda_tension": -3 } },
            "federal.presidency_cohesion": 4,
            "BA.federal_trust": 4,
            "BA.interethnic_tension": -2,
            "flags_add": [
              "talked_izetbegovic",
              "dialogue_izetbegovic_mediate",
              "presidency_mediation_active",
              "confederal_talks_open"
            ],
            "desk_set": { "presidency": { "posture": "mediate" } }
          }
        },
        {
          "id": "ask_ig",
          "label": "Traži zajednički nacrt s Gligorovom.",
          "next": "refuse_ig",
          "effects": {
            "flags_add": [
              "talked_izetbegovic",
              "dialogue_izetbegovic_refuse_ig"
            ]
          }
        },
        {
          "id": "quiet",
          "label": "Tihi kanal. Bez novog jezika.",
          "next": "quiet",
          "effects": {
            "BA.federal_trust": 2,
            "flags_add": [
              "talked_izetbegovic",
              "dialogue_izetbegovic_quiet"
            ]
          }
        }
      ]
    },
    "mediate": {
      "text": "„Dobro. Medijacija drži Predsjedništvo. E3 traži povelju i organ — ne zastoj. Lipanjski papir ostaje van dosjea.“",
      "choices": [
        {
          "id": "end_med",
          "label": "Zapiši.",
          "next": null,
          "effects": { "federal.war_risk": -1 }
        }
      ]
    },
    "refuse_ig": {
      "text": "„Ne. Izetbegović–Gligorov nije dostupan na ovoj kartici ni u ovom memorandumu. Slice A završava 15. svibnja 1991.“",
      "choices": [
        {
          "id": "end_refuse",
          "label": "Prihvati.",
          "next": null,
          "effects": {
            "flags_add": ["izetbegovic_refused_ig_frame"]
          }
        }
      ]
    },
    "quiet": {
      "text": "Sarajevo čuje da je medijacija barem izgovorena. Kalendar ostaje savezni — još.",
      "choices": [
        {
          "id": "end_quiet",
          "label": "Izađi.",
          "next": null,
          "effects": {}
        }
      ]
    }
  },
