            ]
          }
        }
      ]
    },
    "bloc": {
      "text": "Težina bloka bilježi se. Nije naredba Miloševiću — Jović ostaje postupak — ali kohezija Predsjedništva pada.",
      "choices": [
        {
          "id": "end_bloc",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.war_risk": 1,
            "federal.legitimacy": -2
          }
        }
      ]
    },
    "ssrn": {
      "text": "„SSRN još može biti ljuštura. Ako ga zarobi stranka, Predsjedništvo gubi forum. Ako ga vežete uz SIV — Marković nosi knjige, ja nosim postupak.“",
