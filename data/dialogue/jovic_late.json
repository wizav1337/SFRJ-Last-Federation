    },
    "quorum": {
      "text": "„Pet od osam. Bez pet nema izvanrednog, nema naredbe, nema kazališta. Kvorum je jeftiniji od kasarni. I nije Beogradova kruna.“",
      "choices": [
        {
          "id": "end_quorum",
          "label": "Zapiši kvorum — Jović ≠ Milošević.",
          "next": null,
          "effects": {
            "federal.war_risk": -1,
            "federal.legitimacy": 1,
            "flags_add": [
