    "ec": {
      "text": "„EEZ čita note. Nema priznanja. Nema čina VI. Samo kanal.“",
      "choices": [
        {
          "id": "end_ec",
          "label": "Zapiši.",
          "next": null,
          "effects": {
            "federal.war_risk": -1
          }
        }
      ]
    },
    "nam": {
      "text": "Nesvrstani ostaju jezik, ne zid. Lončar ne mijenja Markovićev SIV.",
      "choices": [
        {
          "id": "end_nam",
          "label": "Izađi.",
          "next": null,
          "effects": {
            "federal.legitimacy": 1
          }
