        {
          "id": "ec_channel",
          "label": "Otvori EEZ kanal: nota, ne priznanje.",
          "next": "ec",
          "effects": {
            "desk_add": {
              "ssip": {
                "loyalty": 4,
                "capacity": 3,
                "agenda_tension": 2
              }
            },
            "federal.international_standing": 4,
            "federal.legitimacy": 2,
            "federal.reform_momentum": 2,
            "SI.federal_trust": 2,
            "HR.federal_trust": 2,
            "flags_add": [
              "talked_loncar",
              "dialogue_loncar_ec",
              "ssip_ec_channel",
              "ec_troika_watching"
            ],
            "flags_remove": [
