            "desk_set": {
              "ssip": {
                "posture": "ec_dialogue"
              }
            }
          }
        },
        {
          "id": "nam_hold",
          "label": "Drži Nesvrstane kao štit — stari jezik.",
          "next": "nam",
          "effects": {
